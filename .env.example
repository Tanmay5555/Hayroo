# ==============================================================================
# APEXBAZAAR MULTI-VENDOR MARKETPLACE CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# DATABASE (SUPABASE POSTGRESQL 16 & PRISMA)
# ==============================================================================
# PgBouncer pooled URL (Port 6543)
DATABASE_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for Prisma migrations (Port 5432)
DIRECT_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase Managed Cloud Keys
SUPABASE_URL="https://yourprojectref.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Front-End Supabase Public Keys
VITE_SUPABASE_URL="https://yourprojectref.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ==============================================================================
# FIREBASE SUITE (AUTH, FIRESTORE, STORAGE)
# ==============================================================================
# Server-Side Firebase Admin SDK Service Account
FIREBASE_PROJECT_ID="apexbazaar-dev"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@apexbazaar-dev.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="apexbazaar-dev.appspot.com"

# Front-End Firebase SDK Configuration
VITE_FIREBASE_API_KEY="AIzaSyA_YourFirebaseClientApiKey"
VITE_FIREBASE_AUTH_DOMAIN="apexbazaar-dev.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="apexbazaar-dev"
VITE_FIREBASE_STORAGE_BUCKET="apexbazaar-dev.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ==============================================================================
# IN-MEMORY CACHE & JOB QUEUES (REDIS 7)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=apex_redis_secret
REDIS_DB=0

# ==============================================================================
# AUTHENTICATION & SECURITY (JWT)
