datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "relationJoins"]
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
  SUPPORT_STAFF
  DELIVERY_PARTNER
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

enum MasterOrderStatus {
  PENDING_PAYMENT
  PAID
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SubOrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PACKED
  READY_FOR_PICKUP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum EscrowStatus {
  HELD
  RELEASE_ELIGIBLE
  RELEASED
  DEBITED_REFUND
  DISPUTED
}

enum PaymentMethod {
  RAZORPAY_UPI
  RAZORPAY_CARD
  RAZORPAY_NETBANKING
  STRIPE_CARD
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShipmentStatus {
  LABEL_GENERATED
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_ATTEMPT
  RETURNED_TO_ORIGIN
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  RECEIVED_AT_WAREHOUSE
  INSPECTED_ACCEPTED
  INSPECTED_REJECTED
  REFUND_ISSUED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// -----------------------------------------------------------------------------
// USERS & IDENTITY
// -----------------------------------------------------------------------------

model User {
  id              String         @id @default(uuid())
  email           String?        @unique
  phoneNumber     String         @unique
  passwordHash    String?
  fullName        String
  avatarUrl       String?
  role            UserRole       @default(CUSTOMER)
  isPhoneVerified Boolean        @default(false)
  isEmailVerified Boolean        @default(false)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  addresses       Address[]
  sellerProfile   SellerProfile?
  cart            Cart?
  orders          Order[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  notifications   Notification[]
  couponUsages    CouponUsage[]
  auditLogs       AuditLog[]

  @@index([phoneNumber])
  @@index([email])
  @@index([role])
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  fullName     String
  phoneNumber  String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String   @default("IN")
  landmark     String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([userId])
  @@index([postalCode])
}

// -----------------------------------------------------------------------------
// SELLER / VENDOR ENTITIES
// -----------------------------------------------------------------------------

model SellerProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  businessName      String            @unique
  businessEmail     String            @unique
  businessPhone     String
  storeSlug         String            @unique
  storeDescription  String?
  logoUrl           String?
  bannerUrl         String?
  commissionPercent Decimal?          @db.Decimal(5, 2)
  ratingAverage     Decimal           @default(0.00) @db.Decimal(3, 2)
  ratingCount       Int               @default(0)
  isApproved        Boolean           @default(false)
  isVacationMode    Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kyc               SellerKYC?
  products          Product[]
  inventories       SellerInventory[]
  subOrders         SubOrder[]
  payouts           SellerPayout[]
  ledgerEntries     SellerLedger[]

  @@index([businessName])
  @@index([storeSlug])
  @@index([isApproved])
}

model SellerKYC {
  id                String        @id @default(uuid())
  sellerProfileId   String        @unique
  gstinNumber       String?       @unique
  panNumber         String        @unique
  bankAccountNumber String
  bankIfscCode      String
  bankAccountName   String
  businessAddress   Json
  documentProofUrls String[]
  status            KycStatus     @default(NOT_SUBMITTED)
  rejectionReason   String?
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sellerProfile     SellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([status])
}

// -----------------------------------------------------------------------------
// TAXONOMY & CATALOG
// -----------------------------------------------------------------------------

model Category {
  id                String     @id @default(uuid())
  name              String
  slug              String     @unique
  description       String?
  imageUrl          String?
  parentId          String?
  commissionPercent Decimal    @default(10.00) @db.Decimal(5, 2)
  returnWindowDays  Int        @default(7)
  attributeSchema   Json
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  parent            Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  subcategories     Category[] @relation("CategoryHierarchy")
  products          Product[]

  @@index([parentId])
  @@index([slug])
}

model Product {
  id             String           @id @default(uuid())
  sellerId       String
  categoryId     String
  title          String
  slug           String           @unique
  brand          String
  hsnCode        String
  description    String           @db.Text
  highlights     String[]
  images         String[]
  isPublished    Boolean          @default(true)
  isFeatured     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  seller         SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants       ProductVariant[]
  reviews        Review[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([brand])
  @@index([isPublished])
}

model ProductVariant {
  id             String            @id @default(uuid())
  productId      String
  sku            String            @unique
  title          String
  price          Decimal           @db.Decimal(10, 2)
  mrp            Decimal           @db.Decimal(10, 2)
  costPrice      Decimal?          @db.Decimal(10, 2)
  attributes     Json
  images         String[]
  barcode        String?
  weightKg       Decimal           @default(0.50) @db.Decimal(6, 2)
  dimensionsCm   Json?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventories    SellerInventory[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]

  @@index([productId])
  @@index([sku])
  @@index([price])
}

model SellerInventory {
  id               String         @id @default(uuid())
  sellerId         String
  productVariantId String
  stockQuantity    Int            @default(0)
  lowStockAlert    Int            @default(5)
  isAvailable      Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  seller           SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([sellerId, productVariantId])
  @@index([productVariantId])
  @@index([stockQuantity])
}

// -----------------------------------------------------------------------------
// SHOPPING CART
// -----------------------------------------------------------------------------

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id               String         @id @default(uuid())
  cartId           String
  productVariantId String
  quantity         Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
  @@index([cartId])
}

// -----------------------------------------------------------------------------
// ORDERS & MULTI-VENDOR SPLITTING
// -----------------------------------------------------------------------------

model Order {
  id                String            @id @default(uuid())
  orderNumber       String            @unique
  userId            String
  shippingAddressId String
  subtotalAmount    Decimal           @db.Decimal(10, 2)
  shippingAmount    Decimal           @db.Decimal(10, 2)
  discountAmount    Decimal           @default(0.00) @db.Decimal(10, 2)
  taxAmount         Decimal           @db.Decimal(10, 2)
  grandTotal        Decimal           @db.Decimal(10, 2)
  status            MasterOrderStatus @default(PENDING_PAYMENT)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  shippingAddress   Address           @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)
  subOrders         SubOrder[]
  payment           Payment?
  couponUsages      CouponUsage[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

model SubOrder {
  id                String         @id @default(uuid())
  subOrderNumber    String         @unique
  masterOrderId     String
  sellerId          String
  status            SubOrderStatus @default(PENDING_CONFIRMATION)
  subtotalAmount    Decimal        @db.Decimal(10, 2)
  shippingAmount    Decimal        @db.Decimal(10, 2)
  taxAmount         Decimal        @db.Decimal(10, 2)
  commissionAmount  Decimal        @db.Decimal(10, 2)
  sellerNetPayout   Decimal        @db.Decimal(10, 2)
  escrowStatus      EscrowStatus   @default(HELD)
  escrowReleaseDate DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  masterOrder       Order          @relation(fields: [masterOrderId], references: [id], onDelete: Cascade)
  seller            SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  shipment          Shipment?
  payout            SellerPayout?

  @@index([masterOrderId])
  @@index([sellerId])
  @@index([status])
  @@index([escrowStatus])
}

model OrderItem {
  id               String          @id @default(uuid())
  subOrderId       String
  productVariantId String
  title            String
  sku              String
  unitPrice        Decimal         @db.Decimal(10, 2)
  quantity         Int
  totalPrice       Decimal         @db.Decimal(10, 2)
  taxRatePercent   Decimal         @default(18.00) @db.Decimal(5, 2)
  taxAmount        Decimal         @db.Decimal(10, 2)
  attributes       Json
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  subOrder         SubOrder        @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  returnRequest    ReturnRequest?

  @@index([subOrderId])
  @@index([productVariantId])
}

// -----------------------------------------------------------------------------
// PAYMENTS & ESCROW PAYOUTS
// -----------------------------------------------------------------------------

model Payment {
  id                 String        @id @default(uuid())
  orderId            String        @unique
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus @default(PENDING)
  currency           String        @default("INR")
  amount             Decimal       @db.Decimal(10, 2)
  transactionId      String?       @unique
  gatewayOrderId     String?       @unique
  gatewaySignature   String?
  paidAt             DateTime?
  rawGatewayResponse Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
  @@index([paymentStatus])
}

model SellerPayout {
  id               String        @id @default(uuid())
  sellerId         String
  subOrderId       String        @unique
  payoutAmount     Decimal       @db.Decimal(10, 2)
  commissionKept   Decimal       @db.Decimal(10, 2)
  taxWithheldTcs   Decimal       @default(0.00) @db.Decimal(10, 2)
  payoutTransferId String?       @unique
  isDisbursed      Boolean       @default(false)
  disbursedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  seller           SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  subOrder         SubOrder      @relation(fields: [subOrderId], references: [id], onDelete: Restrict)

  @@index([sellerId])
  @@index([isDisbursed])
}

model SellerLedger {
  id            String        @id @default(uuid())
  sellerId      String
  referenceType String
  referenceId   String
  amount        Decimal       @db.Decimal(10, 2)
  balanceAfter  Decimal       @db.Decimal(10, 2)
  description   String
  createdAt     DateTime      @default(now())

  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// SHIPMENTS & REVERSE LOGISTICS
// -----------------------------------------------------------------------------

model Shipment {
  id                 String         @id @default(uuid())
  subOrderId         String         @unique
  carrierName        String
  trackingNumber     String?        @unique
  shippingLabelUrl   String?
  deliveryOtpHash    String?
  deliveryAgentName  String?
  deliveryAgentPhone String?
  status             ShipmentStatus @default(LABEL_GENERATED)
  estimatedDelivery  DateTime?
  actualDelivery     DateTime?
  rawCarrierLogs     Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  subOrder           SubOrder       @relation(fields: [subOrderId], references: [id], onDelete: Cascade)

  @@index([trackingNumber])
  @@index([status])
}

model ReturnRequest {
  id             String       @id @default(uuid())
  orderItemId    String       @unique
  reason         String
  customerNotes  String?
  proofImageUrls String[]
  status         ReturnStatus @default(REQUESTED)
  reverseAwb     String?      @unique
  sellerNotes    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  refund         Refund?

  @@index([status])
}

model Refund {
  id                  String        @id @default(uuid())
  returnRequestId     String        @unique
  amount              Decimal       @db.Decimal(10, 2)
  gatewayRefundId     String?       @unique
  status              PaymentStatus @default(PENDING)
  reason              String?
  processedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  returnRequest       ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([status])
}

// -----------------------------------------------------------------------------
// REVIEWS, SOCIAL & DISCOVERY
// -----------------------------------------------------------------------------

model Review {
  id                 String   @id @default(uuid())
  userId             String
  productId          String
  rating             Int      @db.SmallInt
  title              String?
  comment            String   @db.Text
  imageUrls          String[]
  isVerifiedPurchase Boolean  @default(true)
  isApproved         Boolean  @default(true)
  helpfulVotes       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
}

model WishlistItem {
  id               String         @id @default(uuid())
  userId           String
  productVariantId String
  createdAt        DateTime       @default(now())

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([userId, productVariantId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// PROMOTIONS & NOTIFICATIONS
// -----------------------------------------------------------------------------

model Coupon {
  id                String             @id @default(uuid())
  code              String             @unique
  description       String
  discountType      CouponDiscountType
  discountValue     Decimal            @db.Decimal(10, 2)
  minimumOrderValue Decimal            @default(0.00) @db.Decimal(10, 2)
  maxDiscountAmount Decimal?           @db.Decimal(10, 2)
  usageLimitTotal   Int?
  usageLimitPerUser Int                @default(1)
  currentUsageCount Int                @default(0)
  validFrom         DateTime
  validUntil        DateTime
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  couponUsages      CouponUsage[]

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  orderId   String
  createdAt DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  oldState   Json?
  newState   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

